# Optional: bring your own image-generation API to render photo-based moodboards
# with scripts/gen_moodboard.py. Without a key, the free palette moodboard is
# used instead (scripts/make_moodboard.py). Copy this file to .env and fill in.
# .env is git-ignored and must never be committed.

IMAGE_PROVIDER=gemini                 # gemini | openai
IMAGE_MODEL=gemini-3.1-flash-image    # "Nano Banana 2"; or e.g. gpt-image-1
IMAGE_API_KEY=                        # your key (stays local, never committed)
# IMAGE_API_BASE=                     # optional base-URL override (resellers / proxies)
