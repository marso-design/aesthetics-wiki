# Optional: bring your own image-generation API to render photo-based moodboards
# with scripts/gen_moodboard.py. Without a key, the free palette moodboard is
# used instead (scripts/make_moodboard.py). Copy this file to .env and fill in.
# .env is git-ignored and must never be committed.

# Provider: gemini | openai
IMAGE_PROVIDER=gemini

# Model id. "Nano Banana 2" = gemini-3.1-flash-image ; or e.g. gpt-image-1
IMAGE_MODEL=gemini-3.1-flash-image

# Your key (stays local, never committed). Paste it after the = , nothing else.
IMAGE_API_KEY=

# Optional base-URL override (resellers / proxies). Leave blank for Google direct.
# IMAGE_API_BASE=
